# Olympus environment template
# Copy this file to .env and fill in your values:
#   cp env.template .env
#
# After editing, restart Olympus:
#   sudo systemctl restart olympus.target

# Dashboard login password (required)
OLYMPUS_PASSWORD=

# API token for programmatic access (required)
OLYMPUS_TOKEN=

# JWT signing secret for session cookies (required, at least 32 chars)
OLYMPUS_JWT_SECRET=

# Path to the events database (optional, default: data/events.db)
# OLYMPUS_DB=/opt/olympus/data/events.db  (absolute path required; relative paths break daemon)

# Workspace root for local file explorer (optional)
# OLYMPUS_WORKSPACE_ROOT=/home

# Provider API keys (add via Providers UI or uncomment below)
# PROVIDER_OPENAI_KEY=
# PROVIDER_DEEPSEEK_KEY=
# PROVIDER_OPENROUTER_KEY=
# PROVIDER_GROQ_KEY=
# PROVIDER_CODEX_KEY=
