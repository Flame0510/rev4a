# Add dynamic Traefik routes here.
# Files in this directory are watched and applied automatically.
#
# Example: route rev4a.yourdomain.com to the Rev4a dashboard:
#
# http:
#   routers:
#     rev4a-dashboard:
#       entryPoints: [websecure]
#       rule: "Host(`rev4a.yourdomain.com`)"
#       service: rev4a
#       tls:
#         certResolver: letsencrypt
#   services:
#     rev4a:
#       loadBalancer:
#         servers:
#           - url: "http://127.0.0.1:3740"
