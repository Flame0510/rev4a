# Rev4a environment — example configuration
#
# On a normal install you do NOT need this file: `rev4a serve` generates
# ~/.config/rev4a/.env on first run with freshly-generated secrets.
# Use this as a reference for what each variable does.

# ── Server ──────────────────────────────────────────────────────────────
PORT=3740
TERMINAL_WS_PORT=3741

# ── Auth (required) ─────────────────────────────────────────────────────
# Dashboard login password — set via the setup wizard on first visit.
REV4A_PASSWORD=
# Secret used to sign session cookies (auto-generated on first run).
REV4A_JWT_SECRET=
# Bearer token for API routes and agent → dashboard communication.
REV4A_TOKEN=
# API key for the Gateway provider endpoint (auto-generated, `rev_` prefix).
REV4A_API_KEY=
# Shared token handed to agent containers.
GATEWAY_TOKEN=

# ── Storage ─────────────────────────────────────────────────────────────
# Defaults live under ~/.config/rev4a/ — override only if you need to.
# REV4A_DATA_DIR=/custom/path
# REV4A_DB=/custom/path/data/events.db
# REV4A_CREDENTIALS_DB=/custom/path/data/credentials.db
# Installation root, used by `rev4a update` to detect a git checkout.
# REV4A_ROOT=

# ── Behaviour ───────────────────────────────────────────────────────────
# IANA timezone used for scheduling and timestamps (e.g. Europe/Rome).
# REV4A_TIMEZONE=
# REV4A_FORCE_INSECURE_COOKIE is no longer read since 1.28.0: the session cookie follows the scheme
# the browser uses (HTTPS: Secure + Strict; plain HTTP: not Secure). Leave it in .env if you may
# roll back to 1.27: without it, plain HTTP by IP on 1.27 loops at login.
# Extra trusted browser origins for cookie-authenticated API writes when a reverse proxy
# rewrites Host. Comma-separated full origins (scheme, host, optional port), no wildcards.
# Unset: Origin must match Host (default ports normalized using the Origin scheme).
# Non-default ports must match too. Only list dashboard origins you control.
# Restart Rev4a after changing this setting. Bearer clients do not need it.
# REV4A_ALLOWED_ORIGINS=https://rev4a.example.com
# Seconds `rev4a serve` waits for the Docker daemon at start-up (default 90, max 600).
# Read from the process environment only (shell export, systemd Environment=): setting
# it in this file has no effect.
# REV4A_DOCKER_WAIT_SECONDS=90
# Registry repository agent images are pulled from.
# REV4A_AGENT_IMAGE_REGISTRY=ghcr.io/flame0510/rev4a/openclaw-agent-base
# Name of the legacy Docker volume older releases kept agent backups in (default rev4a-backups). Set it
# only when a second Rev4a runs on the same Docker (a test instance), so it never migrates the real volume.
# REV4A_LEGACY_BACKUP_VOLUME=rev4a-backups
# Extra hostnames or IPs allowed to reach `next dev` (comma-separated; dev server only).
# REV4A_DEV_ORIGINS=
# Reverse proxies whose X-Forwarded-For names the client for the login lock. Comma-separated
# IPs or CIDRs, IPv4 or IPv6. Unset: no X-Forwarded-For is trusted (loopback included), and
# behind a proxy every visitor shares one lock. A proxy on this host: 127.0.0.1,::1 (this trusts
# every local process; on Docker Desktop also the agent containers). A proxy in Docker: its own
# address, pinned (static --ip / ipv4_address on a network dedicated to the proxy and Rev4a,
# never rev4a-network with the agents), or an agent can take it after a restart.
# REV4A_TRUSTED_PROXIES=192.0.2.10
# Where the panel listens: all (every interface, the default), local (127.0.0.1 and ::1, plus the
# Docker host-gateway address on Linux so agents reach their model) or one IP address of this host.
# Use local behind a reverse proxy or Tailscale. Read at start-up: restart Rev4a.
# REV4A_LISTEN=all
# Where agents' published ports listen: all (0.0.0.0), local (127.0.0.1) or one IP.
# Unset keeps each agent's current address (new agents use every interface); all moves them back
# to every interface. Applies at each agent's next Recreate, Update or Edit, and at create.
# REV4A_AGENT_PORTS_LISTEN=all

# ── Alerts (Telegram) ───────────────────────────────────────────────────
REV4A_ALERTS_ENABLED=false
REV4A_TELEGRAM_BOT_TOKEN=
REV4A_TELEGRAM_CHAT_ID=
REV4A_ALERT_COOLDOWN_MS=600000
REV4A_ALERT_STALE_SECONDS=120
REV4A_ALERT_SMOKE=false

# ── Spend and loop alarms (daemon; alarms only, nothing is blocked) ─────
# Evaluated after each costs pass from the proxy metering, the vendor balance and the session
# copy; shown in System -> Recent alerts and sent to Telegram when it is configured above.
# A zero, negative or malformed value falls back to the default.
# REV4A_SPEND_ALERTS=true                   # false turns all the rules off
# REV4A_SPEND_SESSION_SHARE=1               # session: share of the model's context window (a healthy session compacts before it)
# REV4A_SPEND_SESSION_TOKENS=400000         # session: threshold when the window is unknown
# REV4A_SPEND_LOOP_MIN_FAILURES=10          # loop: errors + calls without usage in the last hour
# REV4A_SPEND_LOOP_MIN_SHARE=0.5            #       ... and this share of the calls
# REV4A_SPEND_LOOP_MIN_PROMPT_TOKENS=1000000
# REV4A_SPEND_DAY_RATIO=3                   # day: times the median active day of the last 28 days
# REV4A_SPEND_DAY_FLOOR_USD=2               #      ... and above this many dollars in 24 h
# REV4A_SPEND_DAY_FLOOR_TOKENS=20000000     #      (tokens for an unpriced model)
# REV4A_SPEND_DAY_NEW_FLOOR_USD=5           #      floor alone, with fewer than 3 active days
# REV4A_SPEND_DAY_NEW_FLOOR_TOKENS=50000000
# REV4A_SPEND_DAY_MIN_ACTIVE_DAYS=3
# REV4A_SPEND_DAY_NEW_COOLDOWN_MS=86400000  #      ... one alarm a day while it has fewer active days
# REV4A_SPEND_DAY_COOLDOWN_MS=21600000      #      at most one alarm per agent in 6 h
# REV4A_SPEND_UNACCOUNTED_RATIO=2           # balance: drop over proxy-metered cost (USD vendors only)
# REV4A_SPEND_UNACCOUNTED_MIN_USD=0.5
# REV4A_SPEND_UNACCOUNTED_REPEAT_COOLDOWN_MS=86400000  # after the 2nd alarm of a vendor within 7 days
# REV4A_SPEND_COOLDOWN_MS=3600000           # at most one other alarm per agent and rule in this time

# ── Gateway provider keys (optional — normally set from the Gateway UI) ─
PROVIDER_OPENAI_API_KEY=
PROVIDER_ANTHROPIC_API_KEY=
PROVIDER_GOOGLE_API_KEY=
PROVIDER_OPENROUTER_API_KEY=
PROVIDER_DEEPSEEK_API_KEY=
PROVIDER_GROQ_API_KEY=
PROVIDER_KIMI_API_KEY=
PROVIDER_GLM_API_KEY=
PROVIDER_QWEN_API_KEY=


# Caddy Domain mode (1.30.0). Configure it with sudo rev4a domain setup <domain>.
# REV4A_DOMAIN=rev4a.example.com
# REV4A_CADDY_FILE=/etc/caddy/rev4a.caddy
# REV4A_CADDY_MAIN=/etc/caddy/Caddyfile
