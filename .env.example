# Rev4a environment — example configuration
#
# On a normal install you do NOT need this file: `rev4a serve` generates
# ~/.config/rev4a/.env on first run with freshly-generated secrets.
# Use this as a reference for what each variable does.

# ── Server ──────────────────────────────────────────────────────────────
PORT=3740
TERMINAL_WS_PORT=3741

# ── Auth (required) ─────────────────────────────────────────────────────
# Dashboard login password — set via the setup wizard on first visit.
REV4A_PASSWORD=
# Secret used to sign session cookies (auto-generated on first run).
REV4A_JWT_SECRET=
# Bearer token for API routes and agent → dashboard communication.
REV4A_TOKEN=
# API key for the Gateway provider endpoint (auto-generated, `rev_` prefix).
REV4A_API_KEY=
# Shared token handed to agent containers.
GATEWAY_TOKEN=

# ── Storage ─────────────────────────────────────────────────────────────
# Defaults live under ~/.config/rev4a/ — override only if you need to.
# REV4A_DATA_DIR=/custom/path
# REV4A_DB=/custom/path/data/events.db
# REV4A_CREDENTIALS_DB=/custom/path/data/credentials.db
# Root exposed by the local file explorer.
# REV4A_WORKSPACE_ROOT=
# Installation root, used by `rev4a update` to detect a git checkout.
# REV4A_ROOT=

# ── Behaviour ───────────────────────────────────────────────────────────
# IANA timezone used for scheduling and timestamps (e.g. Europe/Rome).
# REV4A_TIMEZONE=
# Allow a non-Secure session cookie — plain-HTTP deployments only.
# REV4A_FORCE_INSECURE_COOKIE=false

# ── Alerts (Telegram) ───────────────────────────────────────────────────
REV4A_ALERTS_ENABLED=false
REV4A_TELEGRAM_BOT_TOKEN=
REV4A_TELEGRAM_CHAT_ID=
REV4A_ALERT_COOLDOWN_MS=600000
REV4A_ALERT_STALE_SECONDS=120
REV4A_ALERT_SMOKE=false

# ── Gateway provider keys (optional — normally set from the Gateway UI) ─
PROVIDER_OPENAI_API_KEY=
PROVIDER_ANTHROPIC_API_KEY=
PROVIDER_GOOGLE_API_KEY=
PROVIDER_OPENROUTER_API_KEY=
PROVIDER_DEEPSEEK_API_KEY=
PROVIDER_GROQ_API_KEY=
PROVIDER_KIMI_API_KEY=
PROVIDER_GLM_API_KEY=
PROVIDER_QWEN_API_KEY=

# ── Provider usage/billing lookups (optional) ───────────────────────────
# Read directly by /api/provider-usage to fetch spend and credit balances.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
