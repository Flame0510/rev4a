{
  "name": "@flame0510/project-aether",
  "version": "1.23.0",
  "description": "Rev4a — Revolution for Agents. OpenClaw agent fleet orchestrator.",
  "keywords": [
    "openclaw",
    "rev4a",
    "dashboard",
    "monitoring",
    "ai",
    "agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flame0510/rev4a.git"
  },
  "bugs": {
    "url": "https://github.com/Flame0510/rev4a/issues"
  },
  "homepage": "https://github.com/Flame0510/rev4a#readme",
  "bin": {
    "rev4a": "bin/rev4a.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin/",
    "app/",
    "lib/",
    "public/",
    "scripts/",
    "docs/",
    "agent-templates/",
    "rev4a-rules/",
    "rev4a-skills/",
    "daemon.js",
    "terminal-ws-server.js",
    "server.js",
    "package.json",
    "npm-shrinkwrap.json",
    "proxy.ts",
    "instrumentation.ts",
    "next.config.mjs",
    "tsconfig.json",
    "next-env.d.ts",
    "*.css",
    "*.png",
    "model-pricing.json",
    "model-details.json",
    "models.config.json"
  ],
  "scripts": {
    "dev": "next dev -p 3720",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "check:ui": "node scripts/run-tests.mjs --ui",
    "precheck": "node scripts/precheck.mjs",
    "check:package-types": "node scripts/check-package-types.mjs",
    "start": "rev4a serve",
    "start:all": "rev4a serve",
    "refresh:pricing": "node scripts/refresh-model-pricing.mjs",
    "postinstall": "node bin/postinstall.js",
    "test:login-throttle": "node scripts/test-login-throttle.mjs",
    "check:language": "node scripts/check-language.mjs",
    "test:agent-packages": "node scripts/test-agent-packages.mjs",
    "test:memory-limit": "node scripts/test-agent-memory-limit.mjs",
    "test:docker-exec": "node scripts/test-docker-exec.mjs",
    "test:agent-names": "node scripts/test-agent-names.mjs",
    "test:agent-config-lock": "node scripts/test-agent-config-lock.mjs",
    "test:gateway-cli": "node scripts/test-gateway-cli.mjs",
    "test:credentials": "node scripts/test-gateway-cli.mjs && node scripts/test-credentials-mode.mjs && node scripts/test-credentials-native.mjs && node scripts/test-credentials-managed.mjs && node scripts/test-credentials-detect.mjs && node scripts/test-credentials-intent.mjs && node scripts/test-credentials-mongodb.mjs && node scripts/test-rev4a-skills.mjs",
    "info:suggest": "node scripts/model-info-suggest.mjs",
    "info:verify": "node scripts/model-info-verify.mjs"
  },
  "dependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3": "7.4.3",
    "@types/node": "25.9.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.2",
    "cron-parser": "^5.5.0",
    "d3": "^7.9.0",
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.3",
    "marked": "^18.0.5",
    "next": "16.2.6",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "6.0.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
